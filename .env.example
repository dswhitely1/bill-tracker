NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://don:super@localhost:5432/bills
DB_SSL=false
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
BCRYPT_COST=12
WEB_ORIGIN=http://localhost:4200

# IANA timezone governing every "today" the API computes — due dates,
# overdue derivation, and the nightly horizon roll. Defaults to UTC.
APP_TIMEZONE=UTC
