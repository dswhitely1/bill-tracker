# @nx/nest@23.2.0 peer-requires @nestjs/common and @nestjs/core at
# >=10.0.0 <12.0.0, but this project runs NestJS 12.1.2 (required by the
# spec's stack table and by @nestjs/testing@12.1.2's own peers). @nx/nest
# has not yet declared support for NestJS 12, so a plain `npm install`
# fails ERESOLVE without this. Remove this once @nx/nest widens its peer
# range to include Nest 12.
legacy-peer-deps=true
